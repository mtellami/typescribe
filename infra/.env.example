# Docker Compose and Makefile settings (local development only).
APP_PORT=3000
POSTGRES_PORT=5432
BETTER_AUTH_URL=http://localhost:3000
# `make init` replaces this with a randomly generated secret.
BETTER_AUTH_SECRET=
SUPADATA_API_KEY=

# Optional Google OAuth (Web application client; both values required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
