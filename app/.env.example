# Database (PostgreSQL connection string)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/typescribe

# Optional direct Neon connection for migrations (without -pooler in the host)
# DATABASE_URL_UNPOOLED=postgresql://role:password@ep-example.region.aws.neon.tech/typescribe?sslmode=require

# Import limits
IMPORT_RATE_LIMIT_PER_HOUR=10
IMPORT_MAX_DURATION_SECONDS=3600

# Optional custom User-Agent for transcript requests
TRANSCRIPT_USER_AGENT=

# Required for cloud imports; server-only secret, never NEXT_PUBLIC_ prefixed.
# Supadata uses native captions only; no AI transcript generation.
SUPADATA_API_KEY=

# Test player override: 'fake' | 'youtube' (default: 'youtube')
NEXT_PUBLIC_PLAYER_MODE=youtube

# Authentication: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google OAuth (Web application client; both values required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
