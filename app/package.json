    "clsx": "2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.73.0",
    "next": "15.5.29",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
