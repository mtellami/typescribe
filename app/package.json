    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv-cli": "11.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
